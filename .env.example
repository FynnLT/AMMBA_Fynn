# Copy to .env to enable live blockchain anchoring (optional).
# With the defaults (no .env at all) the stack runs fully self-contained:
# BLOCKCHAIN_MODE=mock simulates the clearMarket transaction.

BLOCKCHAIN_MODE=mock

# --- live mode only -------------------------------------------------------
# Local hardhat node:   RPC_URL=http://host.docker.internal:8545
# Energy Web Volta:     RPC_URL=https://volta-rpc.energyweb.org
RPC_URL=
# Address printed by amm-smart-contract/scripts/deploy.js
CONTRACT_ADDRESS=
# Key of the whitelisted clearing-node account. NEVER commit a real key.
CLEARING_NODE_PRIVATE_KEY=

# --- preference mechanisms (defaults in amm-clearing-node/configuration.yaml)
# Uncomment to change the defaults for the whole stack; the demo UI can also
# override them per request via `preference_params`.
# PREFERENCE_ORDER=preferences_first     # | pro_rata_first
# MULTIPLIER_MODE=multiplicative         # | additive
# MULTIPLIER_SIDES=seller                # | both
# GREEN_MULTIPLIER=0.10
# GREY_LEVY=0.10
# LEVY_CAP=0.20
