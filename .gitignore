# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Node / Hardhat — scoped to the contract project, which is the only thing
# in this repository that uses npm. Unscoped `cache/` or `artifacts/` would
# swallow any directory of that name anywhere in the tree.
amm-smart-contract/node_modules/
amm-smart-contract/artifacts/
amm-smart-contract/cache/
amm-smart-contract/typechain-types/
amm-smart-contract/coverage/

# Environment / secrets
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Office lock files (Excel writes ~$name.xlsx next to an open workbook)
~$*.xlsx
~$*.xlsm
~$*.docx

# Volta evidence output (results, not part of the artifact)
amm-smart-contract/volta_evidence*.csv

# Evaluation output (results, not part of the artifact)
evaluation/out/

# Derived evaluation data: the 672-slot week, regenerated from data/raw/ plus
# the extension seed recorded in the run manifest. The directory itself stays
# in the clone because evaluation/data/derived/.gitignore is tracked; only its
# contents are ignored.
evaluation/data/derived/*
!evaluation/data/derived/.gitignore
